generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  LOCKED
  DELETED
}

enum SellerStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum BusinessType {
  INDIVIDUAL
  COMPANY
}

enum OrderStatus {
  PLACED
  PAID
  SHIPPED
  DELIVERED
  REFUNDED
}

enum DisputeStatus {
  OPEN
  REVIEWING
  CLOSED
}

enum NotificationType {
  ORDER
  INVENTORY
  PAYOUT
  DISPUTE
  SECURITY
  SYSTEM
}

enum AuditActorType {
  USER
  SYSTEM
  STRIPE_WEBHOOK
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String
  role          UserRole        @default(BUYER)
  status        AccountStatus   @default(ACTIVE)
  sellerProfile SellerProfile?
  carts         Cart[]
  addresses     Address[]
  orders        Order[]         @relation("BuyerOrders")
  reviews       Review[]
  notifications Notification[]
  refreshTokens RefreshToken[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([role])
  @@index([status])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  line1       String
  line2       String?
  city        String
  region      String
  postalCode  String
  countryCode String
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model SellerProfile {
  id                    String       @id @default(cuid())
  ownerId               String       @unique
  owner                 User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  shopName              String
  displayName           String
  location              String       @default("United States")
  status                SellerStatus @default(PENDING)
  businessType          BusinessType @default(INDIVIDUAL)
  taxCountry            String       @default("US")
  supportEmail          String
  commissionBasisPoints Int
  stripeAccountId       String?
  products              Product[]
  orderSplits           OrderSplit[]
  payouts               Payout[]
  disputes              Dispute[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([status])
  @@index([shopName])
}

model Product {
  id          String         @id @default(cuid())
  sellerId    String
  seller      SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  title       String
  slug        String         @unique
  description String
  category    String
  sku         String?
  priceCents  Int
  currency    String         @default("USD")
  stock       Int
  isActive    Boolean        @default(true)
  images      ProductImage[]
  reviews     Review[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([sellerId])
  @@index([category])
  @@index([isActive])
  @@index([priceCents])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int     @default(0)

  @@index([productId])
}

model Cart {
  id        String     @id @default(cuid())
  buyerId   String
  buyer     User       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([buyerId])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
}

model Order {
  id                    String       @id @default(cuid())
  orderNumber           String       @unique
  buyerId               String
  buyer                 User         @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  status                OrderStatus  @default(PLACED)
  totalCents            Int
  currency              String       @default("USD")
  stripePaymentIntentId String?
  stripeTransferGroup   String?
  shippingAddressSnapshot Json
  items                 OrderItem[]
  splits                OrderSplit[]
  disputes              Dispute[]
  events                OrderEvent[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([buyerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  sellerId   String
  title      String
  quantity   Int
  priceCents Int

  @@index([orderId])
  @@index([sellerId])
  @@index([productId])
}

model OrderSplit {
  id                  String        @id @default(cuid())
  orderId             String
  order               Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId            String
  seller              SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  subtotalCents       Int
  platformFeeCents    Int
  sellerReceivesCents Int
  stripeTransferId    String?
  createdAt           DateTime      @default(now())

  @@index([orderId])
  @@index([sellerId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  message   String
  metadata  Json?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  rating    Int
  body      String
  createdAt DateTime @default(now())

  @@unique([productId, buyerId])
  @@index([buyerId])
}

model Dispute {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  status      DisputeStatus @default(OPEN)
  reason      String
  amountCents Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([sellerId])
}

model Payout {
  id             String        @id @default(cuid())
  sellerId       String
  seller         SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  amountCents    Int
  currency       String        @default("USD")
  stripePayoutId String?
  availableOn    DateTime
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([sellerId])
  @@index([availableOn])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([type])
}

model AuditLog {
  id          String         @id @default(cuid())
  actorType   AuditActorType
  actorId     String?
  action      String
  entityType  String
  entityId    String
  requestId   String?
  ipAddress   String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model IdempotencyKey {
  id          String   @id @default(cuid())
  key         String
  scope       String
  response    Json?
  createdAt   DateTime @default(now())
  completedAt DateTime?
  expiresAt   DateTime

  @@unique([key, scope])
  @@index([expiresAt])
}

model WebhookEvent {
  id          String    @id
  provider    String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([provider, eventType])
}
